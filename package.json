{
  "name": "tft",
  "private": true,
  "author": "lin-coln",
  "bin": {
    "tft": "./bin/tft.ts"
  },
  "workspaces": {
    "packages": [
      "webui"
    ]
  },
  "type": "module",
  "scripts": {
    "webui:dev": "bun --cwd=webui run dev",
    "prepare": "husky",
    "zig:build": "zig build",
    "screenshot": "bun scripts/screenshot.ts",
    "format": "oxfmt --no-error-on-unmatched-pattern",
    "fetch:assets": "bun run scripts/fetch_tft_data.ts && bun scripts/fetch_models.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "onnxruntime-node": "^1.29.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.65.0",
    "typescript": "^7"
  },
  "lint-staged": {
    "*": [
      "bun run format"
    ]
  }
}
